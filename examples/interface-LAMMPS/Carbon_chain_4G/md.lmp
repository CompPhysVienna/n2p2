###############################################################################
# 4G-HDNNP, non-periodic: carbon chain C10H2 (12 atoms) in vacuum, the
# structure and model of examples/nnp-predict/Carbon_chain_4G (bohr and
# Hartree, converted by cflength and cfenergy). Single point: energy and
# forces are compared with nnp-predict (forces.nnp-predict).
###############################################################################
clear
variable cfgFile         string "chain.data"
variable numSteps        equal  0
variable dt              equal  0.0005
variable hdnnpCutoff     equal  4.24 # >= 8 bohr (4.2334 A)
variable hdnnpDir        string "hdnnp-data"
variable c1              equal  1.8897261328
variable c2              equal  0.0367493254
units metal
boundary f f f
atom_style charge
atom_modify map yes
read_data ${cfgFile}
timestep ${dt}
thermo 1
neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes
pair_style hdnnp/4g dir ${hdnnpDir} showew no showewsum 10 resetew no maxew 1000000 cflength ${c1} cfenergy ${c2} emap "1:C,2:H"
pair_coeff * * ${hdnnpCutoff}
fix 1 all hdnnp 1 1.0e-7 1.0e-1 1.0e-1 100 nnp nnp 1
fix INT all nve
dump F all custom 1 forces.dump id type fx fy fz
dump_modify F sort id format float %20.12e
run ${numSteps}
